rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownsReview() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }

    function createsOwnReview(reviewId) {
      return isSignedIn()
        && request.auth.uid == reviewId
        && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow create, read, update, delete: if isOwner(userId);

      match /favorites/{placeId} {
        allow create, read, update, delete: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow create, read, update, delete: if isOwner(userId);
      }

      match /locationReminders/{reminderId} {
        allow create, read, update, delete: if isOwner(userId);
      }
    }

    match /places/{placeId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if createsOwnReview(reviewId);
        allow update, delete: if ownsReview();
      }
    }
  }
}
