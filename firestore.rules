rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function currentUserData() {
      return userDoc(request.auth.uid).data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && currentUserData().role == 'admin';
    }

    function canAddPlaces() {
      return isSignedIn()
        && currentUserData().role in ['contributor', 'super_user', 'admin'];
    }

    function canManagePlace() {
      return isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    function safeUserUpdate(userId) {
      return isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid',
          'email',
          'subscription',
          'isPremium',
        ])
        && (
          request.resource.data.role == resource.data.role
          || request.resource.data.role == 'contributor'
          || (
            request.resource.data.role == 'super_user'
            && request.resource.data.stats.totalContributions >= 10
            && request.resource.data.stats.averageRating >= 4.3
            && request.resource.data.stats.reportCount <= 2
            && request.resource.data.stats.helpfulVotes >= 20
          )
        )
        && request.resource.data.role != 'admin';
    }

    function ownsReview() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }

    function createsOwnReview(reviewId) {
      return isSignedIn()
        && request.auth.uid == reviewId
        && request.resource.data.userId == request.auth.uid;
    }

    function updatesHelpfulCountOnly() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['helpfulCount']);
    }

    function updatesHelpfulStatOnly() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stats', 'updatedAt'])
        && request.resource.data.stats.totalContributions
          == resource.data.stats.totalContributions
        && request.resource.data.stats.totalReviews
          == resource.data.stats.totalReviews
        && request.resource.data.stats.averageRating
          == resource.data.stats.averageRating
        && request.resource.data.stats.reportCount
          == resource.data.stats.reportCount
        && (
          request.resource.data.stats.helpfulVotes
            == resource.data.stats.helpfulVotes + 1
          || request.resource.data.stats.helpfulVotes
            == resource.data.stats.helpfulVotes - 1
        );
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'regular'
        && request.resource.data.subscription == 'free';
      allow read: if isOwner(userId) || isAdmin();
      allow update: if safeUserUpdate(userId)
        || updatesHelpfulStatOnly()
        || isAdmin();
      allow delete: if isAdmin();

      match /favorites/{placeId} {
        allow create, read, update, delete: if isOwner(userId);
      }

      match /locationReminders/{placeId} {
        allow create, read, update, delete: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow create, read, update, delete: if isOwner(userId);
      }
    }

    match /places/{placeId} {
      allow read: if true;
      allow create: if canAddPlaces()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if canManagePlace();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if createsOwnReview(reviewId);
        allow update: if ownsReview() || isAdmin() || updatesHelpfulCountOnly();
        allow delete: if ownsReview() || isAdmin();

        match /helpfulVotes/{userId} {
          allow read: if true;
          allow create, delete: if isOwner(userId);
          allow update: if false;
        }
      }

      match /reports/{reportId} {
        allow read, update, delete: if isAdmin();
        allow create: if isSignedIn()
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.placeId == placeId;
      }
    }

    match /chats/{chatId} {
      allow read, update: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read, create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}
