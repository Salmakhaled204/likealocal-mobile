rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function currentUserData() {
      return userDoc(request.auth.uid).data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && currentUserData().role == 'admin';
    }

    function canAddPlaces() {
      return isSignedIn()
        && currentUserData().role in ['regular', 'contributor', 'superUser', 'super_user', 'admin'];
    }

    function canManagePlace() {
      return isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    function safeUserUpdate(userId) {
      return isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'uid',
          'email',
          'role',
          'subscription',
          'isPremium',
          'isSuperUser',
          'stats',
          'limits',
        ]);
    }

    function isNonEmptyString(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    function isOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isStringList(value, maxItems, maxLength) {
      return value is list
        && value.size() <= maxItems
        && (value.size() == 0 || value[0] is string && value[0].size() <= maxLength)
        && (value.size() <= 1 || value[1] is string && value[1].size() <= maxLength)
        && (value.size() <= 2 || value[2] is string && value[2].size() <= maxLength)
        && (value.size() <= 3 || value[3] is string && value[3].size() <= maxLength)
        && (value.size() <= 4 || value[4] is string && value[4].size() <= maxLength)
        && (value.size() <= 5 || value[5] is string && value[5].size() <= maxLength)
        && (value.size() <= 6 || value[6] is string && value[6].size() <= maxLength)
        && (value.size() <= 7 || value[7] is string && value[7].size() <= maxLength)
        && (value.size() <= 8 || value[8] is string && value[8].size() <= maxLength)
        && (value.size() <= 9 || value[9] is string && value[9].size() <= maxLength)
        && (value.size() <= 10 || value[10] is string && value[10].size() <= maxLength)
        && (value.size() <= 11 || value[11] is string && value[11].size() <= maxLength)
        && (value.size() <= 12 || value[12] is string && value[12].size() <= maxLength)
        && (value.size() <= 13 || value[13] is string && value[13].size() <= maxLength)
        && (value.size() <= 14 || value[14] is string && value[14].size() <= maxLength);
    }

    function validPlaceData() {
      return request.resource.data.keys().hasOnly([
          'title',
          'description',
          'category',
          'budget',
          'atmosphere',
          'localTip',
          'recommendedDish',
          'address',
          'imageUrls',
          'videoUrls',
          'location',
          'createdBy',
          'createdByName',
          'ownerId',
          'ownerIsSuperUser',
          'averageRating',
          'reviewCount',
          'createdAt',
          'updatedAt',
        ])
        && isNonEmptyString(request.resource.data.title, 120)
        && isNonEmptyString(request.resource.data.description, 1000)
        && request.resource.data.category in [
          'Restaurants',
          'Hidden Gems',
          'Experiences',
          'Cafes',
          'Nightlife',
          'Museum',
          'Shopping',
          'Other',
        ]
        && request.resource.data.budget in ['Cheap', 'Medium', 'Expensive']
        && request.resource.data.atmosphere in [
          'Quiet',
          'Fun',
          'Family',
          'Friends',
          'Romantic',
        ]
        && isOptionalString(request.resource.data.localTip, 300)
        && isOptionalString(request.resource.data.recommendedDish, 120)
        && isNonEmptyString(request.resource.data.address, 300)
        && isStringList(request.resource.data.imageUrls, 15, 500)
        && isStringList(request.resource.data.videoUrls, 5, 500)
        && request.resource.data.location is latlng
        && request.resource.data.createdBy == request.resource.data.ownerId
        && request.resource.data.createdByName is string
        && request.resource.data.createdByName.size() <= 120
        && request.resource.data.ownerId is string
        && request.resource.data.ownerIsSuperUser is bool
        && request.resource.data.averageRating is number
        && request.resource.data.averageRating >= 0
        && request.resource.data.averageRating <= 5
        && request.resource.data.reviewCount is int
        && request.resource.data.reviewCount >= 0
        && request.resource.data.updatedAt is timestamp
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp);
    }

    function validPlaceCreate() {
      return validPlaceData()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.averageRating == 0
        && request.resource.data.reviewCount == 0
        && request.resource.data.ownerIsSuperUser
          == (currentUserData().role in ['superUser', 'super_user']);
    }

    function validPlaceUpdate() {
      return validPlaceData()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.ownerIsSuperUser == resource.data.ownerIsSuperUser
        && request.resource.data.averageRating == resource.data.averageRating
        && request.resource.data.reviewCount == resource.data.reviewCount;
    }

    function validReviewCreate(reviewId) {
      return createsOwnReview(reviewId)
        && request.resource.data.keys().hasOnly([
          'userId',
          'userEmail',
          'userName',
          'text',
          'rating',
          'createdAt',
          'updatedAt',
        ])
        && isOptionalString(request.resource.data.userEmail, 254)
        && isOptionalString(request.resource.data.userName, 120)
        && isNonEmptyString(request.resource.data.text, 300)
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validReviewUpdate() {
      return ownsReview()
        && request.resource.data.keys().hasOnly([
          'userId',
          'userEmail',
          'userName',
          'text',
          'rating',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && isOptionalString(request.resource.data.userEmail, 254)
        && isOptionalString(request.resource.data.userName, 120)
        && isNonEmptyString(request.resource.data.text, 300)
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.updatedAt is timestamp;
    }

    function validChatCreate() {
      return request.resource.data.keys().hasOnly([
          'participants',
          'participantNames',
          'lastMessage',
          'lastMessageTime',
          'createdAt',
          'placeId',
          'unreadCount_' + request.resource.data.participants[0],
          'unreadCount_' + request.resource.data.participants[1],
        ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participantNames is map
        && isOptionalString(request.resource.data.placeId, 120)
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 500
        && request.resource.data.lastMessageTime is timestamp
        && request.resource.data.createdAt is timestamp;
    }

    function validChatUpdate() {
      return request.resource.data.participants == resource.data.participants
        && request.resource.data.participantNames == resource.data.participantNames
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastMessageTime',
          'placeId',
          'unreadCount_' + request.auth.uid,
          'unreadCount_' + resource.data.participants[0],
          'unreadCount_' + resource.data.participants[1],
        ])
        && isOptionalString(request.resource.data.placeId, 120)
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 500
        && request.resource.data.lastMessageTime is timestamp;
    }

    function validMessageCreate(chatId) {
      return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        && request.resource.data.keys().hasOnly([
          'senderId',
          'senderName',
          'text',
          'timestamp',
        ])
        && request.resource.data.senderId == request.auth.uid
        && isOptionalString(request.resource.data.senderName, 120)
        && isNonEmptyString(request.resource.data.text, 500)
        && request.resource.data.timestamp is timestamp;
    }

    function validChatNotificationCreate(userId) {
      return isSignedIn()
        && userId != request.auth.uid
        && request.resource.data.keys().hasOnly([
          'type',
          'title',
          'body',
          'read',
          'chatId',
          'senderId',
          'otherUserId',
          'otherUserName',
          'createdAt',
        ])
        && request.resource.data.type == 'chat'
        && request.resource.data.read == false
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.otherUserId == request.auth.uid
        && request.resource.data.chatId is string
        && request.resource.data.chatId.size() <= 160
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 500
        && isOptionalString(request.resource.data.otherUserName, 120)
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants
        && userId in get(/databases/$(database)/documents/chats/$(request.resource.data.chatId)).data.participants
        && request.resource.data.createdAt is timestamp;
    }

    function validPlaceReportCreate(placeId) {
      return isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.placeId == placeId
        && request.resource.data.type == 'place'
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 120
        && isOptionalString(request.resource.data.details, 500)
        && request.resource.data.createdAt is timestamp;
    }

    function validReviewReportCreate(placeId, reviewId) {
      return isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.placeId == placeId
        && request.resource.data.reviewId == reviewId
        && request.resource.data.type == 'review'
        && request.resource.data.status == 'open'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 120
        && isOptionalString(request.resource.data.details, 500)
        && request.resource.data.createdAt is timestamp;
    }

    function canGetPotentialChat(chatId) {
      return isSignedIn()
        && chatId.matches('.*' + request.auth.uid + '.*');
    }

    function ownsReview() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }

    function createsOwnReview(reviewId) {
      return isSignedIn()
        && request.auth.uid == reviewId
        && request.resource.data.userId == request.auth.uid;
    }

    function updatesHelpfulCountOnly() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['helpfulCount']);
    }

    function updatesHelpfulStatOnly() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stats', 'updatedAt'])
        && request.resource.data.stats.totalContributions
          == resource.data.stats.totalContributions
        && request.resource.data.stats.approvedContributions
          == resource.data.stats.approvedContributions
        && request.resource.data.stats.rejectedContributions
          == resource.data.stats.rejectedContributions
        && request.resource.data.stats.reputationScore
          == resource.data.stats.reputationScore
        && request.resource.data.stats.totalReviews
          == resource.data.stats.totalReviews
        && request.resource.data.stats.averageRating
          == resource.data.stats.averageRating
        && request.resource.data.stats.reportCount
          == resource.data.stats.reportCount
        && (
          request.resource.data.stats.helpfulVotes
            == resource.data.stats.helpfulVotes + 1
          || request.resource.data.stats.helpfulVotes
            == resource.data.stats.helpfulVotes - 1
        );
    }

    function updatesUsageLimitsOnly(userId) {
      return isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['limits', 'updatedAt'])
        && request.resource.data.limits.pinsUsed >= 0
        && request.resource.data.limits.remindersUsed >= 0
        && request.resource.data.limits.aiRequestsToday >= 0
        && request.resource.data.limits.reviewsToday >= 0
        && (
          request.resource.data.limits.pinsUsed == resource.data.limits.pinsUsed
          || request.resource.data.limits.pinsUsed == resource.data.limits.pinsUsed + 1
          || request.resource.data.limits.pinsUsed == resource.data.limits.pinsUsed - 1
        )
        && (
          request.resource.data.limits.remindersUsed == resource.data.limits.remindersUsed
          || request.resource.data.limits.remindersUsed == resource.data.limits.remindersUsed + 1
          || request.resource.data.limits.remindersUsed == resource.data.limits.remindersUsed - 1
        )
        && (
          request.resource.data.limits.aiRequestsToday == resource.data.limits.aiRequestsToday
          || request.resource.data.limits.aiRequestsToday == resource.data.limits.aiRequestsToday + 1
        )
        && (
          request.resource.data.limits.reviewsToday == resource.data.limits.reviewsToday
          || request.resource.data.limits.reviewsToday == resource.data.limits.reviewsToday + 1
        )
        && request.resource.data.updatedAt is timestamp;
    }

    function startsDemoPremium(userId) {
      return isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isPremium', 'subscription', 'updatedAt'])
        && request.resource.data.isPremium == true
        && request.resource.data.subscription.plan == 'premium'
        && request.resource.data.subscription.source == 'demo'
        && request.resource.data.subscription.startedAt is timestamp
        && request.resource.data.subscription.expiresAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function cancelsDemoPremium(userId) {
      return isOwner(userId)
        && resource.data.subscription.source == 'demo'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isPremium', 'subscription', 'updatedAt'])
        && request.resource.data.isPremium == false
        && request.resource.data.subscription.plan == 'free'
        && request.resource.data.subscription.source == null
        && request.resource.data.subscription.startedAt == null
        && request.resource.data.subscription.expiresAt == null
        && request.resource.data.updatedAt is timestamp;
    }

    function updatesContributionProgress(userId) {
      return isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role', 'isSuperUser', 'stats', 'updatedAt'])
        && resource.data.role in ['regular', 'contributor', 'superUser']
        && request.resource.data.role in ['contributor', 'superUser']
        && (
          resource.data.role != 'regular'
          || request.resource.data.role in ['contributor', 'superUser']
        )
        && (
          request.resource.data.role != 'superUser'
          || (
            request.resource.data.stats.approvedContributions >= 10
            && request.resource.data.stats.rejectedContributions <= 2
          )
        )
        && request.resource.data.isSuperUser
          == (request.resource.data.role == 'superUser')
        && request.resource.data.stats.totalContributions
          == resource.data.stats.totalContributions + 1
        && request.resource.data.stats.approvedContributions
          == resource.data.stats.approvedContributions + 1
        && request.resource.data.stats.rejectedContributions
          == resource.data.stats.rejectedContributions
        && request.resource.data.stats.reputationScore
          == resource.data.stats.reputationScore
        && request.resource.data.stats.totalReviews
          == resource.data.stats.totalReviews
        && request.resource.data.stats.averageRating
          == resource.data.stats.averageRating
        && request.resource.data.stats.reportCount
          == resource.data.stats.reportCount
        && request.resource.data.stats.helpfulVotes
          == resource.data.stats.helpfulVotes
        && request.resource.data.updatedAt is timestamp;
    }

    function promotesQualifiedSelfToSuperUser(userId) {
      return isOwner(userId)
        && resource.data.role == 'contributor'
        && resource.data.stats.approvedContributions >= 10
        && resource.data.stats.rejectedContributions <= 2
        && request.resource.data.role == 'superUser'
        && request.resource.data.isSuperUser == true
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role', 'isSuperUser', 'updatedAt'])
        && request.resource.data.updatedAt is timestamp;
    }

    function updatesReviewActivity(userId) {
      return isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['limits', 'stats', 'updatedAt'])
        && request.resource.data.limits.reviewsToday
          == resource.data.limits.reviewsToday + 1
        && request.resource.data.limits.pinsUsed == resource.data.limits.pinsUsed
        && request.resource.data.limits.remindersUsed
          == resource.data.limits.remindersUsed
        && request.resource.data.limits.aiRequestsToday
          == resource.data.limits.aiRequestsToday
        && request.resource.data.stats.totalReviews
          == resource.data.stats.totalReviews + 1
        && request.resource.data.stats.totalContributions
          == resource.data.stats.totalContributions
        && request.resource.data.stats.approvedContributions
          == resource.data.stats.approvedContributions
        && request.resource.data.stats.rejectedContributions
          == resource.data.stats.rejectedContributions
        && request.resource.data.stats.reputationScore
          == resource.data.stats.reputationScore
        && request.resource.data.stats.averageRating
          == resource.data.stats.averageRating
        && request.resource.data.stats.reportCount
          == resource.data.stats.reportCount
        && request.resource.data.stats.helpfulVotes
          == resource.data.stats.helpfulVotes
        && request.resource.data.updatedAt is timestamp;
    }

    function normalizesOwnAccount(userId) {
      return isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isPremium', 'subscription', 'stats', 'limits', 'updatedAt'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.subscription.plan in ['free', 'premium']
        && request.resource.data.isPremium
          == (request.resource.data.subscription.plan == 'premium')
        && request.resource.data.stats.totalContributions
          == (
            resource.data.stats.totalContributions == null
            ? 0
            : resource.data.stats.totalContributions
          )
        && request.resource.data.stats.approvedContributions >= 0
        && request.resource.data.stats.rejectedContributions >= 0
        && request.resource.data.stats.reputationScore >= 0
        && request.resource.data.limits.pinsUsed >= 0
        && request.resource.data.limits.remindersUsed >= 0
        && request.resource.data.limits.aiRequestsToday >= 0
        && request.resource.data.limits.reviewsToday >= 0
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'regular'
        && request.resource.data.isPremium == false
        && request.resource.data.subscription.plan == 'free'
        && request.resource.data.subscription.source == null
        && request.resource.data.subscription.startedAt == null
        && request.resource.data.subscription.expiresAt == null
        && request.resource.data.stats.totalContributions == 0
        && request.resource.data.stats.approvedContributions == 0
        && request.resource.data.stats.rejectedContributions == 0
        && request.resource.data.stats.reputationScore == 0;
      allow read: if isSignedIn();
      allow update: if safeUserUpdate(userId)
        || normalizesOwnAccount(userId)
        || updatesUsageLimitsOnly(userId)
        || startsDemoPremium(userId)
        || cancelsDemoPremium(userId)
        || updatesContributionProgress(userId)
        || promotesQualifiedSelfToSuperUser(userId)
        || updatesReviewActivity(userId)
        || updatesHelpfulStatOnly()
        || isAdmin();
      allow delete: if isAdmin();

      match /favorites/{placeId} {
        allow create, read, update, delete: if isOwner(userId);
      }

      match /locationReminders/{placeId} {
        allow create, read, update, delete: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow create: if isOwner(userId) || validChatNotificationCreate(userId);
        allow read, update, delete: if isOwner(userId);
      }
    }

    match /places/{placeId} {
      allow read: if true;
      allow create: if canAddPlaces() && validPlaceCreate();
      allow update: if canManagePlace() && validPlaceUpdate();
      allow delete: if canManagePlace();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if createsOwnReview(reviewId);
        allow update: if ownsReview() || isAdmin() || updatesHelpfulCountOnly();
        allow delete: if ownsReview() || isAdmin();

        match /helpfulVotes/{userId} {
          allow read: if true;
          allow create, delete: if isOwner(userId);
          allow update: if false;
        }

        match /reports/{reportId} {
          allow read, update, delete: if isAdmin();
          allow create: if validReviewReportCreate(placeId, reviewId);
        }
      }

      match /reports/{reportId} {
        allow read, update, delete: if isAdmin();
        allow create: if validPlaceReportCreate(placeId);
      }
    }

    match /chats/{chatId} {
      allow get: if canGetPotentialChat(chatId)
        || (
          isSignedIn()
          && request.auth.uid in resource.data.participants
        );
      allow list: if isSignedIn()
        && request.auth.uid in resource.data.participants;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && validChatUpdate();
      allow create: if isSignedIn() && validChatCreate();

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() && validMessageCreate(chatId);
      }
    }
  }
}
